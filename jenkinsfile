pipeline {
    agent any

    stages {
        stage('Setup') {
            steps {
                sh '''
                    python3 -m venv .venv
                    . .venv/bin/activate
                    pip install -r requirements.txt
                '''
            }
        }
        stage('Test') {
            steps {
                sh '''
                    . .venv/bin/activate
                    coverage run -m pytest
                '''
            }
        }
        stage('Reports') {
            steps {
                sh '''
                    . .venv/bin/activate
                    coverage report
                    coverage xml
                    coverage html
                '''
            }
        }
    }
}
